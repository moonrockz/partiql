// The PartiQL-encoded Ion codec. This package's default alias is `ion`, so
// the Ion data model is imported as `@ion_core`.

import {
  "moonrockz/partiql-value" @value,
  "moonrockz/ion/ion" @ion_core,
  "moonrockz/ion/text",
  "moonrockz/ion/binary",
  "moonrockz/ion/schema",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/bigint",
  "moonbitlang/core/debug",
}

import {
  "moonrockz/partiql-value/ion" @partiql_ion,
  "moonrockz/ion/schema",
  "moonrockz/ion/binary",
  "moonbitlang/core/encoding/utf8",
  "moonrockz/ion/text",
  "moonrockz/expect",
} for "test"
