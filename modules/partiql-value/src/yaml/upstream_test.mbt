// Spec Example 2.18. Multi-line Flow Scalars
test "yaml-test-suite 4CQQ: supported" {
  let source = "plain:\n  This unquoted scalar\n  spans many lines.\n\nquoted: \"So does this\n  quoted scalar.\\n\"\n"
  let expected = @ion.read_text(
    "{\n  \"plain\": \"This unquoted scalar spans many lines.\",\n  \"quoted\": \"So does this quoted scalar.\\n\"\n}\n",
  )
  let actual = @yaml.read_text(source) catch { e => fail(e.message()) }
  @expect.expect(actual).to_equal(expected)
}

