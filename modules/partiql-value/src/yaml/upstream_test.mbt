///|
// Tags in Block Sequence
test "yaml-test-suite 2AUY: supported" {
  let source = " - !!str a\n - b\n - !!int 42\n - d\n"
  let expected = @ion.read_text("[\n  \"a\",\n  \"b\",\n  42,\n  \"d\"\n]\n")
  let actual = @yaml.read_text(source) catch { e => fail(e.message()) }
  @expect.expect(actual).to_equal(expected)
}

///|
// Block Scalar Keep
test "yaml-test-suite 6FWR: supported" {
  let source = "--- |+\n ab\n \n  \n...\n"
  let expected = @ion.read_text("\"ab\\n\\n \\n\"\n")
  let actual = @yaml.read_text(source) catch { e => fail(e.message()) }
  @expect.expect(actual).to_equal(expected)
}

