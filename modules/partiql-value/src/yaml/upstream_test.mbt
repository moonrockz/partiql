// Spec Example 8.5. Chomping Trailing Lines
test "yaml-test-suite F8F9: supported" {
  let source = " # Strip\n  # Comments:\nstrip: |-\n  # text\n  \n # Clip\n  # comments:\n\nclip: |\n  # text\n \n # Keep\n  # comments:\n\nkeep: |+\n  # text\n\n # Trail\n  # comments.\n"
  let expected = @ion.read_text(
    "{\n  \"strip\": \"# text\",\n  \"clip\": \"# text\\n\",\n  \"keep\": \"# text\\n\\n\"\n}\n",
  )
  let actual = @yaml.read_text(source) catch { e => fail(e.message()) }
  @expect.expect(actual).to_equal(expected)
}

