///|
// Spec Example 2.15. Folded newlines are preserved for "more indented" and blank lines
test "yaml-test-suite 6VJK: supported" {
  let source = ">\n Sammy Sosa completed another\n fine season with great stats.\n\n   63 Home Runs\n   0.288 Batting Average\n\n What a year!\n"
  let expected = @ion.read_text(
    "\"Sammy Sosa completed another fine season with great stats.\\n\\n  63 Home Runs\\n  0.288 Batting Average\\n\\nWhat a year!\\n\"\n",
  )
  let actual = @yaml.read_text(source) catch { e => fail(e.message()) }
  @expect.expect(actual).to_equal(expected)
}

