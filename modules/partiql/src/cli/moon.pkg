// The `partiql` command line as a library: `run` takes the arguments and
// returns the output, so tests drive it without a process.

import {
  "moonbitlang/core/argparse",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
  "moonrockz/partiql-syntax" @syntax,
  "moonrockz/partiql-eval" @eval,
  "moonrockz/partiql-value" @value,
  "moonrockz/partiql-value/ion" @partiql_ion,
  "moonrockz/partiql-value/json" @partiql_json,
}

import {
  "moonrockz/partiql/cli",
  "moonrockz/partiql-value" @value,
  "moonbitlang/core/encoding/utf8",
  "moonrockz/expect",
  "moonrockz/partiql-value/arbitrary",
  "moonrockz/partiql-value/ion" @partiql_ion,
  "moonrockz/ion/text",
  "moonbitlang/core/quickcheck",
  "moonrockz/partiql-eval" @eval,
  "moonbitlang/x/time",
} for "test"

import {
  "moonrockz/expect",
} for "wbtest"
