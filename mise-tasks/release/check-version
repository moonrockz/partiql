#!/usr/bin/env bash
#MISE description="Fail unless all module versions, sibling imports and the CLI version equal the release version"
#USAGE arg "<version>" help="Release version to check, without a leading v"
set -euo pipefail

EXPECTED="${usage_version:-${1:-}}"
EXPECTED="${EXPECTED#v}"
STATUS=0

for mod in modules/partiql-value modules/partiql-syntax modules/partiql-eval modules/partiql modules/partiql-conformance; do
  ACTUAL=$(sed -nE 's/^version[[:space:]]*=[[:space:]]*"([^"]*)".*/\1/p' "$mod/moon.mod" | head -1)
  if [ "$ACTUAL" != "$EXPECTED" ]; then
    echo "::error::$mod/moon.mod has version '$ACTUAL', expected '$EXPECTED'" >&2
    STATUS=1
  fi
  # Imports of sibling modules must use the same version.
  while read -r dep; do
    [ -z "$dep" ] && continue
    if [ "${dep##*@}" != "$EXPECTED" ]; then
      echo "::error::$mod/moon.mod imports $dep, expected version '$EXPECTED'" >&2
      STATUS=1
    fi
  done < <(grep -oE '"moonrockz/partiql[a-z-]*@[^"]+"' "$mod/moon.mod" | tr -d '"')
done

CLI=$(sed -nE 's/^pub let version : String = "([^"]*)".*/\1/p' modules/partiql/src/cli/version.mbt)
if [ "$CLI" != "$EXPECTED" ]; then
  echo "::error::CLI version is '$CLI', expected '$EXPECTED'" >&2
  STATUS=1
fi

[ "$STATUS" -eq 0 ] && echo "All versions match $EXPECTED"
exit "$STATUS"
