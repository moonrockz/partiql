#!/usr/bin/env bash
#MISE description="Publish the modules to mooncakes.io in dependency order"
set -euo pipefail

# partiql-conformance is never published.
MODULES=(partiql-value partiql-syntax partiql-eval partiql)

if [ ! -f ~/.moon/credentials.json ]; then
  echo "Error: run 'mise run release:credentials' first (needs MOONCAKES_USER_TOKEN)." >&2
  exit 1
fi

for mod in "${MODULES[@]}"; do
  echo "Publishing moonrockz/$mod..."
  # Refresh the index so the next module resolves the version just published.
  moon update
  (cd "modules/$mod" && moon publish)
done
echo "Published: ${MODULES[*]}"
