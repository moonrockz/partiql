#!/usr/bin/env bash
#MISE description="Run all workspace tests (optionally on one target)"
#USAGE flag "--target <target>" help="wasm, wasm-gc, js or native"
set -euo pipefail

if [ -n "${usage_target:-}" ]; then
  mise run test:docs --target "$usage_target"
  moon test --target "$usage_target"
else
  mise run test:docs
  moon test
fi
